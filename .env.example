# Copia este archivo como .env (o .env.local) y completa los valores de tu proyecto Supabase.
# Supabase Dashboard > Project Settings > API

REACT_APP_SUPABASE_URL=https://tu-proyecto.supabase.co
REACT_APP_SUPABASE_ANON_KEY=tu_clave_anon_publica

# Opcional: también se aceptan las variables con prefijo VITE_ (útil en Vite).
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica
